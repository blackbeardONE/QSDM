# Dockerfile.miner — GPU-enabled QSDM miner node
# =====================================================
# This image builds the full QSDM binary (no build tag) PLUS the CUDA runtime
# required by pkg/mining/cuda (added in Major Update Phase 4). It is intended
# for operators who want to run a miner node contributing Proof-of-Work
# emission for the Cell coin.
#
# Build:
#   docker build -f QSDM/Dockerfile.miner -t qsdm/miner:latest QSDM/
#
# Runtime:
#   Requires nvidia-container-toolkit on the host and `--gpus all` (or a
#   device mapping) when running the container.
#
# Notes:
#   - The builder is NVIDIA's official CUDA 12.3 devel image on Ubuntu 22.04.
#     Since 2026-11-19 the runtime stage is distroless (gcr.io/distroless/cc-debian13,
#     nonroot; Debian 12 until the same day): glibc, libstdc++ and OpenSSL from Debian plus only the shared
#     libraries the miner binary links (liboqs, the mesh3d CUDA kernels,
#     libcudart). No shell, package manager, wget, tar, perl or login tools, so
#     the Trivy scan no longer reports the ~30 unfixable Ubuntu 22.04 package
#     CVEs of the old CUDA runtime base. The host driver (libcuda) is injected
#     by nvidia-container-toolkit, as before; the CUDA toolchain (12.3) and the
#     GPUs it supports are unchanged.
#   - The `mining_enabled` environment variable is set to true by default;
#     the startup guard (pkg/mining/roleguard) will refuse role=validator
#     with mining_enabled=true.

# ---- builder stage ----------------------------------------------------------
FROM nvidia/cuda:12.3.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    cmake \
    make \
    git \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Go toolchain (pinned to match validator image).
ENV GO_VERSION=1.26.11
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
        -o /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz
ENV PATH=/usr/local/go/bin:${PATH}

# Build & install liboqs.
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/open-quantum-safe/liboqs.git && \
    cd liboqs && \
    mkdir build && cd build && \
    cmake -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON .. && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /tmp/liboqs && \
    ldconfig

# Build QSDM miner binary (full build profile, includes pkg/mining/cuda when
# added in Phase 4). We do NOT set the validator_only tag here.
WORKDIR /app
COPY source ./source
RUN cd source && \
    for attempt in 1 2 3; do \
        go mod download && break; \
        if [ "$attempt" = 3 ]; then exit 1; fi; \
        sleep $((attempt * 5)); \
    done

# Compile the CUDA kernel library that pkg/mesh3d/cuda.go links against.
# Without this step `go build -tags cuda` dies with
#   /usr/bin/ld: cannot find -lmesh3d_kernels
# because the cgo LDFLAGS reference `-lmesh3d_kernels` but the shared
# object is an artefact the repo deliberately does NOT check in (it is
# produced by nvcc from kernels/sha256_validate.cu; see
# QSDM/.github/workflows/cuda-build.yml and
# pkg/mesh3d/kernels/BUILD.md). We are already on an NVIDIA devel
# image, so nvcc is on PATH here; install the resulting .so to the
# standard linker search path and run ldconfig so the subsequent
# `go build -tags "miner cuda"` can resolve the symbol.
RUN cd source/pkg/mesh3d/kernels && \
    nvcc -shared -Xcompiler -fPIC \
         -o libmesh3d_kernels.so sha256_validate.cu && \
    cp libmesh3d_kernels.so /usr/local/lib/ && \
    ldconfig

RUN cd source && CGO_ENABLED=1 \
    CGO_CFLAGS="-I/usr/local/include -I/usr/local/cuda/include" \
    CGO_LDFLAGS="-L/usr/local/lib -L/usr/local/cuda/lib64 -loqs -lssl -lcrypto -lmesh3d_kernels -lcudart" \
    go build -tags "miner cuda" \
        -o ../qsdm-miner ./cmd/qsdm

# Healthcheck helper for the shell-less runtime (replaces `wget` in HEALTHCHECK).
COPY deploy/docker/healthcheck /tmp/healthcheck
RUN cd /tmp/healthcheck && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /app/qsdm-healthcheck .

# Stage the runtime tree for the distroless image: the miner, its healthcheck, the `qsdm` alias, /app/data, and
# every shared library the binary resolves that the distroless cc base does not ship. glibc, libgcc_s, libstdc++
# and OpenSSL (libssl/libcrypto) come from the base image's tracked Debian packages, so the scanner keeps seeing
# them; the CUDA driver (libcuda) is injected by nvidia-container-toolkit at run time and is not copied.
RUN set -eu; \
    mkdir -p /out/usr/local/bin /out/usr/local/lib /out/app/data; \
    cp /app/qsdm-miner /app/qsdm-healthcheck /out/usr/local/bin/; \
    ln -s qsdm-miner /out/usr/local/bin/qsdm; \
    ldd /app/qsdm-miner | awk '/=> \//{print $1" "$3}' | while read -r soname path; do \
      case "$soname" in \
        linux-vdso*|ld-linux*|libc.so*|libm.so*|libdl.so*|libpthread.so*|librt.so*|libresolv.so*) continue ;; \
        libgcc_s.so*|libstdc++.so*|libssl.so*|libcrypto.so*|libcuda.so*) continue ;; \
      esac; \
      cp -L "$path" "/out/usr/local/lib/$soname"; \
      echo "runtime lib: $soname <- $path"; \
    done; \
    if ldd /app/qsdm-miner | grep -v 'libcuda' | grep -q 'not found'; then ldd /app/qsdm-miner; exit 1; fi

# ---- runtime stage ---------------------------------------------------------
# Distroless (2026-11-19): no shell, package manager, wget, tar, perl or login tools in the shipped image. The old
# nvidia/cuda:12.3.2-runtime-ubuntu22.04 base carried ~30 Ubuntu 22.04 package CVEs with no fix available.
# Debian 13 (trixie) since the same day: the Debian 12 base carried ~70 open Trivy findings in libc6, libssl3 and
# the GCC 12 runtime libraries, most without a bookworm fix; trixie ships glibc 2.41, OpenSSL 3.5 and GCC 14
# runtimes (the builder's Ubuntu 22.04 glibc 2.35 / OpenSSL 3.0 ABI runs on them), so the separate libssl3 refresh
# stage is no longer needed.
FROM gcr.io/distroless/cc-debian13:nonroot

COPY --from=builder /out/usr/local/ /usr/local/
COPY --from=builder --chown=65532:65532 /out/app/ /app/

WORKDIR /app

# libp2p, API, dashboard, log viewer.
EXPOSE 4001 8080 8081 9000

ENV LD_LIBRARY_PATH=/usr/local/lib
ENV QSDM_NODE_ROLE=miner
ENV QSDM_MINING_ENABLED=true
# Surface NVIDIA visible devices so nvidia-container-toolkit wires them in (the nvidia/cuda base used to set these).
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_REQUIRE_CUDA=cuda>=12.3

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD ["/usr/local/bin/qsdm-healthcheck"]

# The :nonroot base runs as uid/gid 65532. Miner processes do not need root; they only need /dev/nvidia* device
# access, which the container toolkit provides.
USER 65532:65532

CMD ["/usr/local/bin/qsdm-miner"]
