# Copy to /etc/qsdm/account.conf with mode 0600. Never commit real values.
QSDM_ACCOUNT_LISTEN=127.0.0.1:8092
QSDM_ACCOUNT_PUBLIC_BASE_URL=https://qsdm.tech
QSDM_ACCOUNT_STORE_PATH=/var/lib/qsdm-account/accounts.json

# Exactly 32 random bytes encoded as base64url, base64, or hex.
# Generate: openssl rand -base64 32
QSDM_ACCOUNT_DATA_KEY=REPLACE_WITH_32_RANDOM_BYTES

# Email magic links (optional when Telegram is configured).
QSDM_ACCOUNT_SMTP_HOST=smtp.example.com
QSDM_ACCOUNT_SMTP_PORT=587
QSDM_ACCOUNT_SMTP_USERNAME=accounts@qsdm.tech
QSDM_ACCOUNT_SMTP_PASSWORD=REPLACE_WITH_SMTP_SECRET
QSDM_ACCOUNT_SMTP_FROM="QSDM Account <accounts@qsdm.tech>"
QSDM_ACCOUNT_SMTP_TLS=true

# Telegram OIDC (optional when SMTP is configured). Configure the allowed URL
# https://qsdm.tech/api/account/telegram/callback in BotFather > Web Login.
QSDM_ACCOUNT_TELEGRAM_CLIENT_ID=REPLACE_WITH_BOTFATHER_CLIENT_ID
QSDM_ACCOUNT_TELEGRAM_CLIENT_SECRET=REPLACE_WITH_BOTFATHER_CLIENT_SECRET
